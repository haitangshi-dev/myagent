{
  "name": "my-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MY_AGENT — native-feeling web frontend (React + TS + Tailwind), wrapped as an Electron desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --port 4173",
    "electron": "electron .",
    "electron:hot": "ELECTRON_DEV=1 electron .",
    "fetch:sherpa": "node ../scripts/fetch-sherpa-assets.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --config"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.0.20",
    "@fontsource/geist-sans": "^5.0.20",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  },
  "build": {
    "appId": "com.myagent.desktop",
    "productName": "MY_AGENT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "backend/web/dist"
      },
      {
        "from": "..",
        "to": "backend",
        "filter": [
          "main.py",
          "start.py",
          "requirements.txt",
          "config/**/*",
          "agents/**/*",
          "providers/**/*",
          "server/**/*",
          "scripts/**/*",
          "skills/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MY_AGENT-Setup-${version}.${ext}"
    },
    "icon": "public/icon.ico"
  },
  "author": "MY_AGENT"
}
